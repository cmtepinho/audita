{
  "name": "audita",
  "version": "0.1.0",
  "private": true,
  "description": "Audita — auditoria mensal de faturas com processamento e cofre locais",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev-server.mjs",
